---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CallToActionSection from "../components/CallToActionSection.astro";
import Heading from "../components/Heading.astro";
import Icon from "../components/Icon.astro";
import heroImage from "../assets/placeholders/hero-services-placeholder.jpg";
import topics from "../data/topics.json";
---

<Layout
	title="Leistungen & Schwerpunkte"
	description="Psychotherapie in Graz mit Schwerpunkt Psychodrama: Ängste & Panikattacken, Depression & Burnout, Beziehung & Partnerschaft, Berufsstress, Trauer & Verlust."
>
	<PageHero
		title="Leistungen & Schwerpunkte"
		description="Einzelsetting in der Praxis in Graz — humanistische Psychotherapie und Psychodrama. Wählen Sie das Thema, das Sie gerade bewegt, oder <a href='/contact' class='text-theme-primary font-medium underline'>fragen Sie direkt ein Erstgespräch an</a>."
		image={heroImage}
	/>

	<section class="section bg-theme-surface">
		<div class="container">
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{topics.map((t) => (
					<a href={`/services/${t.slug}`} class="group bg-theme-surface-muted p-6 rounded-xl border border-theme-border hover:shadow-lg hover:border-theme-primary transition-all duration-300">
						<div class="flex items-center gap-3 mb-3">
							<div class="flex-shrink-0 w-10 h-10 rounded-lg bg-theme-primary/10 flex items-center justify-center group-hover:bg-theme-primary transition-colors duration-300">
								<Icon name="medical" size="md" class="text-theme-primary group-hover:text-white transition-colors duration-300" />
							</div>
							<h2 class="text-xl font-semibold text-theme-text-primary group-hover:text-theme-primary transition-colors">{t.cardTitle}</h2>
						</div>
						<p class="text-theme-text-secondary leading-relaxed">{t.cardSummary}</p>
						<span class="inline-flex items-center mt-4 text-sm font-medium text-theme-primary">
							Mehr erfahren
							<Icon name="arrow-right" size="sm" class="ml-1 transition-transform group-hover:translate-x-1" />
						</span>
					</a>
				))}
			</div>

			<div class="mt-16 grid lg:grid-cols-2 gap-10">
				<div class="bg-theme-surface-muted rounded-xl p-8 border border-theme-border">
					<Heading level="h2" class="mb-4">Was ist Psychodrama?</Heading>
					<p class="text-theme-text-secondary leading-relaxed mb-4">Manche Dinge lassen sich nicht nur besprechen. Im Psychodrama begegnen Sie Ihren Themen handelnd — im geschützten Einzelsetting, in Ihrem Tempo, ohne Publikum und ohne etwas „können“ zu müssen.</p>
					<a href="/psychodrama" class="text-theme-primary font-medium inline-flex items-center">Mehr zur Methode <Icon name="arrow-right" size="sm" class="ml-1" /></a>
				</div>
				<div class="bg-theme-surface-muted rounded-xl p-8 border border-theme-border">
					<Heading level="h2" class="mb-4">Ablauf & Kosten</Heading>
					<p class="text-theme-text-secondary leading-relaxed mb-4">Erstgespräch und Folgetermine kosten 100&nbsp;€ je Einheit (45 Minuten). Während der Fachausbildung unter Lehrsupervision ist keine Kassenabrechnung möglich — viele Zusatzversicherungen übernehmen einen Teil.</p>
					<a href="/ablauf-und-kosten" class="text-theme-primary font-medium inline-flex items-center">Alle Details zu Ablauf & Kosten <Icon name="arrow-right" size="sm" class="ml-1" /></a>
				</div>
			</div>
		</div>
	</section>

	<CallToActionSection
		heading="Unsicher, welches Thema passt?"
		subheading="Schreiben Sie mir einfach — wir klären im unverbindlichen Erstgespräch, wo Sie stehen und welcher Weg der richtige ist."
		primaryButtonText="Erstgespräch anfragen"
		primaryButtonLink="/contact"
	/>
</Layout>
