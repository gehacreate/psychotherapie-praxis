---
import Layout from "../layouts/Layout.astro";
import Heading from "../components/Heading.astro";
import Button from "../components/Button.astro";
---

<Layout title="Seite nicht gefunden" description="Die angeforderte Seite existiert nicht.">
	<section class="section min-h-[60vh] flex items-center">
		<div class="container text-center">
			<p class="text-sm font-medium tracking-widest uppercase text-theme-primary mb-4">404</p>
			<Heading level="h1" size="page" align="center" class="mb-6">Seite nicht gefunden</Heading>
			<p class="text-lg text-theme-text-secondary mb-8 max-w-xl mx-auto">Die angeforderte Seite existiert nicht oder wurde verschoben. Zurück zur Startseite:</p>
			<Button variant="primary" href="/">Zur Startseite</Button>
		</div>
	</section>
</Layout>
