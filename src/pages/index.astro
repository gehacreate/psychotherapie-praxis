---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CallToActionSection from "../components/CallToActionSection.astro";
import Heading from "../components/Heading.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import heroImage from "../assets/placeholders/hero-main-placeholder.jpg";
import faqs from "../data/faqs.json";
import topics from "../data/topics.json";
---

<Layout
	title="Psychotherapie in Graz"
	description="Psychotherapie & Psychodrama in Graz: Begleitung bei Ängsten, Depression, Burnout, Beziehungsfragen, Trauer & Verlust. Erstgespräch 100 € (45 Min.), zeitnah möglich."
>
	<PageHero
		title="Psychotherapie in Graz"
		description="Herzlich willkommen — wenn Sie sich eine Veränderung wünschen oder gerade nicht mehr allein klarkommen, sind Sie hier richtig. Ich begleite junge Erwachsene, Erwachsene und ältere Menschen bei Ängsten und Panikattacken, Depressionen, Burnout, Beziehungsfragen, Verlust und Trauer — wertschätzend, vertraulich und in dem Tempo, das sich für Sie richtig anfühlt. <strong>Momentan sind wieder Plätze frei — ein Erstgespräch kann zeitnah stattfinden.</strong>"
		image={heroImage}
	/>

	<!-- Schwerpunkte -->
	<section class="section bg-theme-surface">
		<div class="container">
			<div class="text-center mb-12">
				<p class="text-sm font-medium tracking-widest uppercase text-theme-primary mb-4">Schwerpunkte</p>
				<Heading level="h2" align="center">Wobei ich Sie begleite</Heading>
				<p class="text-theme-text-secondary text-lg mt-4 max-w-2xl mx-auto">Oft hängen mehrere Themen zusammen. Sie müssen nicht wissen, wo Sie anfangen sollen — wir finden es gemeinsam heraus.</p>
			</div>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{topics.map((t) => (
					<a href={`/services/${t.slug}`} class="group bg-theme-surface-muted p-6 rounded-xl border border-theme-border hover:shadow-lg hover:border-theme-primary transition-all duration-300">
						<div class="flex items-center gap-3 mb-3">
							<div class="flex-shrink-0 w-10 h-10 rounded-lg bg-theme-primary/10 flex items-center justify-center group-hover:bg-theme-primary transition-colors duration-300">
								<Icon name="heart" size="md" class="text-theme-primary group-hover:text-white transition-colors duration-300" />
							</div>
							<h3 class="text-xl font-semibold text-theme-text-primary group-hover:text-theme-primary transition-colors">{t.cardTitle}</h3>
						</div>
						<p class="text-theme-text-secondary leading-relaxed">{t.cardSummary}</p>
						<span class="inline-flex items-center mt-4 text-sm font-medium text-theme-primary">
							Mehr erfahren
							<Icon name="arrow-right" size="sm" class="ml-1 transition-transform group-hover:translate-x-1" />
						</span>
					</a>
				))}
			</div>
			<p class="text-center mt-8 text-theme-text-secondary">
				Noch nie in Therapie gewesen? <a href="/erstes-mal" class="text-theme-primary font-medium underline">Was Sie vor dem ersten Mal wissen sollten</a> · <a href="/psychodrama" class="text-theme-primary font-medium underline">Was ist Psychodrama?</a>
			</p>
		</div>
	</section>

	<!-- Notfallkontakte -->
	<section class="section bg-theme-primary-darker text-white">
		<div class="container">
			<div class="max-w-3xl mx-auto text-center">
				<Heading level="h2" class="text-white mb-6">In akuter Krise — rund um die Uhr, anonym, kostenfrei</Heading>
				<ul class="space-y-2 text-white/90 text-lg">
					<li><strong>Psychiatrisches Krisentelefon Steiermark:</strong> 0800 44 99 33</li>
					<li><strong>Frauenhelpline:</strong> 0800 222 555</li>
					<li><strong>Männernotruf:</strong> 05 06 77</li>
					<li>Bei akuter Gefahr: <strong>144</strong> (Notruf)</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- FAQ preview -->
	<section class="section bg-theme-surface">
		<div class="container">
			<div class="narrow mx-auto">
				<div class="text-center mb-12">
					<p class="text-sm font-medium tracking-widest uppercase text-theme-primary mb-4">FAQ</p>
					<Heading level="h2" align="center">Ihre Fragen & Antworten</Heading>
				</div>
				<FaqAccordion items={faqs.slice(0, 4)} />
				<div class="text-center mt-10">
					<Button variant="primary" href="/info">Alle Fragen & Antworten</Button>
				</div>
			</div>
		</div>
	</section>

	<CallToActionSection
		heading="Der erste Schritt ist der wichtigste"
		subheading="Schreiben Sie mir — auch wenn Sie noch unsicher sind. Im Erstgespräch klären wir vertraulich und unverbindlich, ob und wie ich Sie begleiten kann."
		primaryButtonText="Erstgespräch anfragen"
		primaryButtonLink="/contact"
	/>
</Layout>
