---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CallToActionSection from "../components/CallToActionSection.astro";
import heroImage from "../assets/placeholders/service-detail-placeholder.jpg";
import faqs from "../data/faqs.json";

const faqJsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((f) => ({
		"@type": "Question",
		name: f.question,
		acceptedAnswer: { "@type": "Answer", text: f.answer.replace(/<[^>]+>/g, " ") },
	})),
};
---

<Layout
	title="Häufige Fragen (FAQ)"
	description="Antworten auf die häufigsten Fragen zu Psychotherapie in Graz: Ablauf, Kosten (100 €/45 Min.), Vertraulichkeit, Dauer, Online & Hausbesuche, Psychodrama."
>
	<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} slot="head" />
	<PageHero
		title="Ihre Fragen & Antworten"
		description="Egal, ob Sie unsicher sind, ob Psychotherapie das Richtige für Sie ist, oder ob Sie praktische Infos brauchen — hier beantworte ich die wichtigsten Fragen."
		image={heroImage}
	/>

	<section class="section bg-theme-surface">
		<div class="container narrow">
			<FaqAccordion items={faqs} />
		</div>
	</section>

	<CallToActionSection
		heading="Ihre Frage war nicht dabei?"
		subheading="Schreiben Sie mir — ich beantworte Ihre Fragen gerne im persönlichen, vertraulichen Kontakt."
		primaryButtonText="Kontakt aufnehmen"
		primaryButtonLink="/contact"
	/>
</Layout>
