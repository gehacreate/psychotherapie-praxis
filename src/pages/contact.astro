---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Heading from "../components/Heading.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";
import heroImage from "../assets/placeholders/contact-image-placeholder.jpg";
---

<Layout
	title="Erstgespräch anfragen & Kontakt"
	description="Erstgespräch in Graz anfragen: unverbindlich und vertraulich. Terminvereinbarung Mo–Fr 09:00–18:00 Uhr. In akuten Krisen: Krisentelefon Steiermark 0800 44 99 33."
>
	<PageHero
		title="Erstgespräch anfragen"
		description="Sie bestimmen das Tempo — wir beginnen genau dort, wo Sie gerade stehen. Der Einstieg ist unverbindlich: Im Erstgespräch lernen wir uns kennen und schauen, wo Sie stehen. <strong>Momentan sind wieder Plätze frei.</strong>"
		image={heroImage}
	/>

	<section class="section bg-theme-surface">
		<div class="container">
			<div class="grid lg:grid-cols-2 gap-12">
				<!-- Kontakt-Infos -->
				<div>
					<Heading level="h2" class="mb-6">Hier erreichen Sie mich</Heading>
					<ul class="space-y-4 text-lg text-theme-text-secondary">
						<li class="flex items-start"><Icon name="location" size="md" class="text-theme-primary mr-3 mt-1 flex-shrink-0" /><span>Praxis für Psychotherapie<br />Musterstraße 1<br />8010 Graz, Österreich</span></li>
						<li class="flex items-start"><Icon name="phone" size="md" class="text-theme-primary mr-3 mt-1 flex-shrink-0" /><span>+43 (0)000 000000<br /><span class="text-sm">Mo–Fr 09:00–18:00 Uhr für die Terminvereinbarung</span></span></li>
						<li class="flex items-start"><Icon name="email" size="md" class="text-theme-primary mr-3 mt-1 flex-shrink-0" /><span><a href="mailto:praxis@beispiel.at" class="text-theme-primary underline">praxis@beispiel.at</a></span></li>
						<li class="flex items-start"><Icon name="info" size="md" class="text-theme-primary mr-3 mt-1 flex-shrink-0" /><span>Therapietermine derzeit freitags 13:00–18:00 Uhr</span></li>
					</ul>

					<Heading level="h3" class="mt-10 mb-4">Anfahrt</Heading>
					<ul class="space-y-2 text-theme-text-secondary">
						<li>Praxis in Graz — ÖPNV-Haltestellen fußläufig erreichbar</li>
						<li>Parkplätze in der Kurzparkzone vor der Praxis</li>
						<li>Fahrradabstellplätze vor der Praxis</li>
						<li>Bei eingeschränkter Mobilität: Hausbesuche in Graz auf Anfrage</li>
					</ul>

					<div class="mt-10 p-6 bg-theme-primary-darker text-white rounded-xl">
						<Heading level="h3" class="text-white mb-3">In akuter Krise</Heading>
						<ul class="space-y-1 text-white/90">
							<li><strong>Psychiatrisches Krisentelefon Steiermark:</strong> 0800 44 99 33 (24/7, anonym, kostenfrei)</li>
							<li><strong>Frauenhelpline:</strong> 0800 222 555</li>
							<li><strong>Männernotruf:</strong> 05 06 77</li>
							<li>Bei akuter Gefahr: <strong>144</strong></li>
						</ul>
					</div>
				</div>

				<!-- Formular -->
				<div class="bg-theme-surface-muted rounded-xl p-8 border border-theme-border">
					<Heading level="h2" class="mb-4">Schreiben Sie mir</Heading>
					<p class="text-theme-text-secondary mb-6">Kopieren Sie gern folgenden Text in die Nachricht: <em>„Hallo, ich würde gerne ein unverbindliches Erstgespräch vereinbaren. Freundliche Grüße“</em></p>
					<p class="text-theme-text-secondary mb-6">Alles, was Sie mir schreiben, unterliegt der gesetzlichen Schweigepflicht.</p>
					<Button variant="primary" size="lg" href="mailto:praxis@beispiel.at?subject=Erstgespräch%20anfragen">E-Mail schreiben</Button>
				</div>
			</div>
		</div>
	</section>
</Layout>
